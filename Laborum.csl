<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="note" default-locale="es-ES">
  <info>
    <title>Revista de Derecho de la Seguridad Social - Laborum</title>
    <id>http://www.zotero.org/styles/revista-de-derecho-de-la-seguridad-social-laborum</id>
    <link href="http://www.zotero.org/styles/revista-de-derecho-de-la-seguridad-social-laborum" rel="self"/>
    <link href="https://revista.laborum.es/index.php/revsegsoc/en/about/submissions" rel="documentation"/>
    <author>
      <name>Custom CSL Generator</name>
    </author>
    <category citation-format="note"/>
    <category field="law"/>
    <updated>2026-03-30T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <locale xml:lang="es">
    <terms>
      <term name="editor" form="short">Ed.</term>
      <term name="director" form="short">Dir.</term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
    </terms>
  </locale>

  <macro name="author-note">
    <choose>
      <if type="chapter" match="any">
        <text value="VV.AA."/>
      </if>
      <else>
        <names variable="author">
          <name name-as-sort-order="first" initialize-with="." delimiter="; " font-variant="small-caps">
            <name-part name="family" font-variant="small-caps"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
          <substitute>
            <names variable="editor"/>
            <names variable="collection-editor"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>

  <macro name="editor-container">
    <choose>
      <if type="chapter" match="any">
        <names variable="editor collection-editor">
          <name initialize-with="." delimiter=" y " font-variant="small-caps"/>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </if>
    </choose>
  </macro>

  <macro name="author-short">
    <names variable="author">
      <name name-as-sort-order="first" initialize-with="." delimiter="; " font-variant="small-caps">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <choose>
      <if type="article-journal article-magazine article-newspaper chapter" match="any">
        <text variable="title" prefix="«" suffix="»"/>
      </if>
      <else-if type="legal_case">
        <text variable="title"/>
      </else-if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="publisher-info">
    <group delimiter=", ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
      <date variable="issued">
        <date-part name="year"/>
      </date>
    </group>
  </macro>

  <macro name="locators">
    <group delimiter=" ">
      <label variable="locator" form="short"/>
      <text variable="locator"/>
    </group>
  </macro>

  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <citation et-al-min="5" et-al-use-first="1">
    <layout delimiter="; " suffix=".">
      <choose>
        <if position="subsequent">
          <group delimiter=", ">
            <text macro="author-short"/>
            <text value="op. cit." font-style="italic"/>
            <text macro="locators"/>
          </group>
        </if>
        <else-if type="legal_case bill legislation" match="any">
          <group delimiter=", ">
            <text variable="title"/>
            <date variable="issued" form="numeric"/>
            <text variable="authority"/>
            <text variable="number" prefix="n. "/>
            <text variable="DOI" prefix="(ECLI:" suffix=")"/>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <text macro="author-note"/>
            <text macro="title"/>
            <choose>
              <if type="article-journal article-magazine" match="any">
                <text variable="container-title" font-style="italic"/>
                <text variable="volume" prefix="vol. "/>
                <text variable="issue" prefix="n. "/>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
                <choose>
                  <if variable="locator">
                    <text macro="locators"/>
                  </if>
                  <else>
                    <text macro="pages"/>
                  </else>
                </choose>
              </if>
              <else-if type="chapter" match="any">
                <text macro="editor-container"/>
                <text macro="publisher-info"/>
                <choose>
                  <if variable="locator">
                    <text macro="locators"/>
                  </if>
                  <else>
                    <text macro="pages"/>
                  </else>
                </choose>
              </else-if>
              <else>
                <text macro="publisher-info"/>
                <choose>
                  <if variable="locator">
                    <text macro="locators"/>
                  </if>
                  <else>
                    <text macro="pages"/>
                  </else>
                </choose>
              </else>
            </choose>
          </group>
        </else>
      </choose>
    </layout>
  </citation>

  <bibliography>
    <layout>
      <text variable="title"/>
    </layout>
  </bibliography>
</style>
